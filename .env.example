# Supabase (PostgreSQL database + Auth)
# Public values (safe for NEXT_PUBLIC_*, sent to the browser):
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Server-only secret (NEVER expose to the browser, never prefix with NEXT_PUBLIC_):
SUPABASE_SERVICE_ROLE_KEY=""
# Optional allowlist fallback if the Supabase user has no app_metadata admin flag:
# ADMIN_EMAILS="you@example.com"

# Cloudflare R2 file storage (actual documents stay here; Supabase stores metadata only)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""

# Anonymous feedback identity salt (optional; defaults to SUPABASE_URL)
# FEEDBACK_COOKIE_SALT=""
